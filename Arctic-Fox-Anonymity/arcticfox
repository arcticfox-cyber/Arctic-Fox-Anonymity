VERSION="1.0.3"
NAME="Arctic Fox Anonymity"

#--- Tor ports & paths ---------------------------------------------------------
TOR_SOCKS_PORT=9050
TOR_TRANS_PORT=9040
TOR_DNS_PORT=5353
TOR_CONTROL_PORT=9051
TOR_VIRTUAL_NET="10.192.0.0/10"
TOR_USER="debian-tor"
TORRC="/etc/tor/torrc"
TORRC_MARKER="# === Arctic Fox Anonymity configuration ==="
TORRC_END="# === End Arctic Fox Anonymity ==="
BACKUP_DIR="/var/lib/arcticfox"
RESOLV="/etc/resolv.conf"
CHAIN_NAT="AF_NAT"      # nat OUTPUT chain
CHAIN_FILT="AF_FILT"    # filter OUTPUT chain (IPv4)
CHAIN_FILT6="AF_FILT6"  # filter OUTPUT chain (IPv6)


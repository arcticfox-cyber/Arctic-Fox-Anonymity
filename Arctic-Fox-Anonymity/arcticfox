print_banner() {
    local n=${#BANNER_LINES[@]} i color
    for ((i=0; i<n; i++)); do
        color=$(( 51 - i * 5 / (n - 1) ))   # cyan -> green gradient
        printf '\e[38;5;%sm%s\e[0m\n' "$color" "${BANNER_LINES[$i]}"
    done
    printf '\n'
    printf '     %s%s%s  %sv%s%s  %s|  All traffic through Tor  |  Kali Linux%s\n' \
        "$C_W" "$NAME" "$C_0" "$C_G" "$VERSION" "$C_0" "$C_B" "$C_0"
    printf '\n'
